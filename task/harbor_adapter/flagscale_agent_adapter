class FlagScaleInstalledAgent(BaseInstalledAgent):
    """Run FlagScale-Agent inside a Harbor task container."""

    # This adapter converts FlagScale native events
# into an ATIF-v1.7 trajectory after execution.
# Enable SUPPORTS_ATIF only after validation
# succeeds on real Harbor trials.
    # Change to True only after FlagScale-Agent reliably writes a valid
    # /logs/agent/trajectory.json file.
    # FlagScale原生事件会在任务结束后转换为经过验证的ATIF-v1.7轨迹。
    SUPPORTS_ATIF = True

    AGENT_VENV = "/opt/flagscale-agent-venv"
    MOUNTED_SOURCE = "/mnt/flagscale-agent-host"
    LOCAL_SOURCE = "/opt/flagscale-agent-src"

    # BERT environment setup, fine-tuning and evaluation may exceed two hours.
    AGENT_RUN_TIMEOUT_SEC = 14400

    _ANSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")

    # Example:
    # Turn 7 | 5149.7s | ↑1559k ↓20,461
    _TURN_SUMMARY_RE = re.compile(
        r"Turn\s+(\d+)\s*\|\s*([\d.]+)s\s*\|\s*"
        r"↑\s*([\d.,]+[kKmM]?)\s*"
        r"↓\s*([\d.,]+[kKmM]?)"
    )

    # Fallback parser for FlagScale-Agent's human-readable tool lines.
    _TOOL_RE = re.compile(
        r"(?:⚡|📝|📖|🔍|⚙️|📋)\s+"
        r"([A-Za-z_][A-Za-z0-9_.-]*)"
    )

    @staticmethod
    def name() -> str:
        return "flagscale-agent"

    def version(self) -> str | None:
        return "local-source"

